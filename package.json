{
  "name": "covenant-wedding-planner",
  "version": "1.0.0",
  "private": true,
  "description": "The Covenant Wedding Planner — a static, offline-capable client-side planning app. Optional cloud sync API under server/. Dev tooling for serving the app and running consistency/visual checks.",
  "scripts": {
    "serve": "python3 -m http.server 8000",
    "server": "npm run start --prefix server",
    "server:install": "npm install --prefix server",
    "server:init-db": "npm run db:init --prefix server",
    "check": "for f in tools/check-duplicate-functions.js tools/check-main-panels.js tools/check-panel-display-css.js tools/check-panel-nesting.js tools/check-panel-nesting2.js; do echo \"=== $f ===\"; node \"$f\" || exit 1; done",
    "verify:catering": "node tools/verify-catering-layout.mjs",
    "verify:panel-bleed": "node tools/verify-panel-bleed.mjs",
    "verify:offline-ga": "node scripts/_verify-offline-ga.mjs",
    "verify:cloud-sync": "node scripts/_verify-cloud-sync-smoke.mjs",
    "verify:second-device": "node scripts/_verify-second-device-sync.mjs",
    "verify:vendor-sync": "node scripts/_verify-vendor-sync.mjs",
    "verify:payment-sync": "node scripts/_verify-payment-sync.mjs",
    "verify:budget-sync": "node scripts/_verify-budget-sync.mjs",
    "verify:seating-sync": "node scripts/_verify-seating-sync.mjs",
    "verify:contract-sync": "node scripts/_verify-contract-sync.mjs",
    "verify:contracts-sync": "node scripts/_verify-contract-sync.mjs",
    "verify:timeline-sync": "node scripts/_verify-timeline-sync.mjs",
    "verify:packet-sync": "node scripts/_verify-packet-sync.mjs",
    "verify:packets-sync": "node scripts/_verify-packet-sync.mjs",
    "verify:rental-sync": "node scripts/_verify-rental-sync.mjs",
    "verify:rentals-sync": "node scripts/_verify-rental-sync.mjs",
    "verify:party-sync": "node scripts/_verify-party-sync.mjs",
    "verify:task-sync": "node scripts/_verify-task-sync.mjs",
    "verify:tasks-sync": "node scripts/_verify-task-sync.mjs",
    "verify:vtimeline-sync": "node scripts/_verify-vtimeline-sync.mjs",
    "verify:vendor-arrivals-sync": "node scripts/_verify-vtimeline-sync.mjs",
    "playwright:install": "npx playwright install chromium"
  },
  "devDependencies": {
    "playwright": "1.55.0"
  }
}
