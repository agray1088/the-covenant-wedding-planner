# Covenant sync API — local development
PORT=8787
HOST=0.0.0.0
# Host Node → db-proxy on 15432 (Compose). Avoids Windows local Postgres on 5432/5433
# and Docker Desktop SCRAM failures (backend is trust via baked pg_hba).
DATABASE_URL=postgres://covenant:covenant@127.0.0.1:15432/covenant
DATABASE_SSL=0
SESSION_DAYS=30
# CORS origin for the static planner (npm run serve → :8000). Comma-separated OK.
CORS_ORIGIN=http://localhost:8000
# Optional: public base URL (local usually http://127.0.0.1:18787 for OAuth redirects).
PUBLIC_URL=http://127.0.0.1:18787
# Planner origin for Google OAuth return (defaults to first CORS_ORIGIN).
CLIENT_APP_URL=http://localhost:8000
# Optional: bootstrap a demo user on first boot (password hashed at runtime)
BOOTSTRAP_EMAIL=demo@covenant.local
BOOTSTRAP_PASSWORD=covenant-demo
BOOTSTRAP_USERNAME=demo
# Long random string — required before public traffic (see .env.production.example)
# SESSION_SECRET=
# Trust reverse-proxy headers (set 1 on Railway/Fly/Render)
# TRUST_PROXY=0
# Serve static planner from repo root (hosted single-service mode)
# SERVE_STATIC=0
# Feature flags — Google/SMTP auto-enable when secrets are set; set 0 to force off.
# FEATURE_GOOGLE_AUTH=
# FEATURE_EMAIL=
# FEATURE_RSVP=0
# FEATURE_LANDING=0
# FEATURE_PHOTOS=0
# --- Google Sign-In (docs/AUTH.md) ---
# Redirect URI to register in Google Cloud Console:
#   ${PUBLIC_URL}/auth/google/callback
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=
# --- SMTP (forgot password / forgot username) ---
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=noreply@covenant.local
# SMTP_SECURE=0
# Magic-link placeholder — not wired; reserved for later.
# MAGIC_LINK_FROM=noreply@covenant.local
# MAGIC_LINK_BASE_URL=http://localhost:8000
# PASSWORD_RESET_HOURS=2
# --- Photo object storage (docs/BACKUP_AND_PHOTOS.md) ---
# Metadata in Postgres; blobs here (never huge base64 in DB rows).
# PHOTO_STORAGE=local
# PHOTO_LOCAL_DIR=
# S3_BUCKET=
# S3_REGION=us-east-1
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_ENDPOINT=
# R2_BUCKET=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_ENDPOINT=
# R2_REGION=auto
