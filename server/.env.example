# Covenant sync API — local development
PORT=8787
HOST=0.0.0.0
# Host Node → db-proxy on 15432 (Compose). Avoids Windows local Postgres on 5432/5433
# and Docker Desktop SCRAM failures (backend is trust via baked pg_hba).
DATABASE_URL=postgres://covenant:covenant@127.0.0.1:15432/covenant
DATABASE_SSL=0
SESSION_DAYS=30
# CORS origin for the static planner (npm run serve → :8000). Comma-separated OK.
CORS_ORIGIN=http://localhost:8000
# Optional: public base URL (local usually unset). Hosted deploy sets this to HTTPS.
# PUBLIC_URL=http://127.0.0.1:18787
# Optional: bootstrap a demo user on first boot (password hashed at runtime)
BOOTSTRAP_EMAIL=demo@covenant.local
BOOTSTRAP_PASSWORD=covenant-demo
# Long random string — required before public traffic (see .env.production.example)
# SESSION_SECRET=
# Trust reverse-proxy headers (set 1 on Railway/Fly/Render)
# TRUST_PROXY=0
# Serve static planner from repo root (hosted single-service mode)
# SERVE_STATIC=0
# Feature flags (stubs until roadmap steps land)
# FEATURE_GOOGLE_AUTH=0
# FEATURE_EMAIL=0
# FEATURE_RSVP=0
# FEATURE_LANDING=0
# Google / SMTP placeholders — not wired in v1; reserved for accounts + RSVP.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=noreply@covenant.local
# Magic-link placeholder — not wired in v1; reserved for later SMTP.
# MAGIC_LINK_FROM=noreply@covenant.local
# MAGIC_LINK_BASE_URL=http://localhost:8000
