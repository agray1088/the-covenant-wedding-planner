# Covenant sync API — production / hosted template
# Copy to server/.env.production (or set these in Railway/Fly/Render secrets).
# Never commit real secrets.

# --- Core ---
NODE_ENV=production
PORT=8787
HOST=0.0.0.0
# Public HTTPS origin of this API (no trailing slash). Used for OAuth
# redirect URIs, RSVP / guest-portal links, password-reset emails, and health.
PUBLIC_URL=https://api.example.com
# Planner UI origin for Google OAuth return (?cloudToken=) — defaults to first CORS_ORIGIN.
CLIENT_APP_URL=https://app.example.com
# Trust X-Forwarded-* from the platform proxy (Railway/Fly/Render = 1)
TRUST_PROXY=1

# Managed Postgres connection string from your host (required).
# Railway: attach Postgres → DATABASE_URL is injected automatically.
# Fly: fly postgres attach … or paste the connection string.
# Render: Internal Database URL preferred when API + DB are on Render.
DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/covenant
# Most managed Postgres require TLS. Set 1 on Railway/Fly/Render.
DATABASE_SSL=1

# Comma-separated browser origins allowed to call the API (planner UI).
# Include every place the static app is served from.
CORS_ORIGIN=https://app.example.com,https://example.com

# Long random string (≥32 chars). Rotate if leaked. Reserved for signed
# cookies / future CSRF; sessions today use opaque DB tokens.
SESSION_SECRET=replace-with-a-long-random-string
SESSION_DAYS=30

# Serve the static planner from the API image (0=API only, 1=also serve ../)
# Useful on a single Railway/Fly service; keep 0 if you host the SPA elsewhere.
SERVE_STATIC=0
STATIC_ROOT=

# Optional bootstrap user (leave empty in real production after first admin exists)
BOOTSTRAP_EMAIL=
BOOTSTRAP_PASSWORD=

# --- Feature flags ---
# Google / email auto-enable when secrets below are set. Set to 0 to force-disable.
# FEATURE_GOOGLE_AUTH=
# FEATURE_EMAIL=
FEATURE_RSVP=0
FEATURE_LANDING=0
FEATURE_PHOTOS=0
FEATURE_PARTNER_INVITES=0
# Vendor portal tokens — defaults on when unset in app code; set 1 to enable in prod.
FEATURE_VENDOR_TOKENS=0

# --- Google Sign-In (roadmap step 2 — see docs/AUTH.md) ---
# Google Cloud Console → OAuth client → Authorized redirect URIs:
#   ${PUBLIC_URL}/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# --- Email / SMTP (password reset, username reminder, later RSVP) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@example.com
SMTP_SECURE=0
PASSWORD_RESET_HOURS=2
# Or a provider API key instead of raw SMTP (future):
# EMAIL_PROVIDER=resend
# EMAIL_API_KEY=

# --- Object storage for photo backup (roadmap step 3/5 — see docs/BACKUP_AND_PHOTOS.md) ---
# Metadata in Postgres (`photos` table). Blobs in object storage — not base64 columns.
FEATURE_PHOTOS=0
PHOTO_STORAGE=local
# PHOTO_LOCAL_DIR=
# S3_BUCKET=
# S3_REGION=us-east-1
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_ENDPOINT=
# Cloudflare R2 (S3-compatible) — use PHOTO_STORAGE=r2
# R2_BUCKET=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_ENDPOINT=https://<accountid>.r2.cloudflarestorage.com
# R2_REGION=auto

# --- Local prod-compose only (docker-compose.prod.yml) ---
# POSTGRES_USER=covenant
# POSTGRES_PASSWORD=replace-me
# POSTGRES_DB=covenant
# API_HOST_PORT=18787
